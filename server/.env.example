# --- Core ---
DATABASE_URL="postgresql://collectpilot:collectpilot@localhost:5544/collectpilot"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
PUBLIC_URL="http://localhost:5173"
JOB_SECRET="change-me-too"

# --- Gemini (https://aistudio.google.com/apikey). Leave empty to run with the rule-based fallback. ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# --- Telegram bot token from @BotFather. Leave empty to disable Telegram. ---
TELEGRAM_BOT_TOKEN=""
# Telegram chat id of the owner, for briefings (send /start to the bot to see the id)
OWNER_TELEGRAM_CHAT_ID=""

# --- Google OAuth client (Gmail, Calendar, Sheets, Drive). Leave empty to simulate email and calendar. ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"

# --- Safety: in demo mode only addresses / chat ids on this allow-list are contacted (comma separated) ---
DEMO_MODE="true"
ALLOWED_EMAILS=""
ALLOWED_TELEGRAM_CHAT_IDS=""
